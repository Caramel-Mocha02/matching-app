# このファイルを .env にコピーして値を設定してください（.env は Git に含めない）
PORT=3001

# Supabase 管理画面 → Project Settings → API Keys で確認できます
SUPABASE_URL=
# Secret key（sb_secret_ で始まる）。RLS を無視して全データを読み書きできるため、絶対に公開しないこと
SUPABASE_SECRET_KEY=

# Claude API のキー（https://platform.claude.com/settings/keys）。未設定の間は定型文の説明を表示する
ANTHROPIC_API_KEY=

# npm run seed で、テストユーザーからのいいね・メッセージを届けるアカウント（カンマ区切り）。空欄なら誰にも送らない
SEED_DEMO_EMAILS=
